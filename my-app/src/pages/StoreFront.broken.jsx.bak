import { useState, useEffect, useRef, useCallback } from "react";
import { ChevronDown, Menu, X } from "lucide-react";

/**
 * CapstoreSpotlightHero
 * ----------------------------------------------------------------
 * Drop-in replacement for <CapstoreHero /> in storefront.jsx.
 *
 * Same interaction pattern as the "Measured" wearable hero spec —
 * parallax grid, giant hero word, cursor-following spotlight that
 * reveals a video underneath — but rebuilt in CapStore's existing
 * design language (Barlow Condensed, Share Tech Mono, the
 * blue/purple/coral/gold/teal accent family) instead of importing
 * a new serif/sans pairing. Assumes the GLOBAL_CSS custom
 * properties (--bg, --blue, --w, --mono, --display, etc.) from
 * storefront.jsx are already injected on the page.
 *
 * Swap VIDEO_SRC for real CapStore product footage when ready —
 * everything else (grid, spotlight radius, mask feather, type
 * scale) is tuned to work with any 16:9/portrait clip.
 * ----------------------------------------------------------------
 */

const VIDEO_SRC = "https://assets.mixkit.co/videos/40746/40746-720.mp4";

const NAV_LINKS = [
  { label: "Shop" },
  { label: "Fitted" },
  { label: "Snapback", chevron: true },
  { label: "Track Order" },
];

const SPOTLIGHT_RADIUS = 260; // px
const LERP = 0.1;

export default function CapstoreSpotlightHero({ onShopNow }) {
  const [menuOpen, setMenuOpen] = useState(false);
  const sectionRef = useRef(null);
  const canvasRef = useRef(null);
  const maskLayerRef = useRef(null);
  const gridRef = useRef(null);

  // raw + smoothed cursor position (relative to section)
  const target = useRef({ x: -9999, y: -9999 });
  const smooth = useRef({ x: -9999, y: -9999 });
  const rafId = useRef(null);

  useEffect(() => {
    document.body.style.overflow = menuOpen ? "hidden" : "";
    return () => { document.body.style.overflow = ""; };
  }, [menuOpen]);

  const handlePointerMove = useCallback((e) => {
    const rect = sectionRef.current?.getBoundingClientRect();
    if (!rect) return;
    target.current.x = e.clientX - rect.left;
    target.current.y = e.clientY - rect.top;
  }, []);

  const handlePointerLeave = useCallback(() => {
    target.current.x = -9999;
    target.current.y = -9999;
  }, []);

  useEffect(() => {
    const canvas = canvasRef.current;
    const section = sectionRef.current;
    if (!canvas || !section) return;

    const ctx = canvas.getContext("2d");
    const dpr = Math.min(window.devicePixelRatio || 1, 2);

    const resize = () => {
      const { width, height } = section.getBoundingClientRect();
      canvas.width = width * dpr;
      canvas.height = height * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };
    resize();
    window.addEventListener("resize", resize);

    const tick = () => {
      smooth.current.x += (target.current.x - smooth.current.x) * LERP;
      smooth.current.y += (target.current.y - smooth.current.y) * LERP;

      const { width, height } = section.getBoundingClientRect();
      ctx.clearRect(0, 0, width, height);

      const { x, y } = smooth.current;
      const grad = ctx.createRadialGradient(x, y, 0, x, y, SPOTLIGHT_RADIUS);
      grad.addColorStop(0, "rgba(255,255,255,1)");
      grad.addColorStop(0.4, "rgba(255,255,255,1)");
      grad.addColorStop(0.6, "rgba(255,255,255,0.75)");
      grad.addColorStop(0.75, "rgba(255,255,255,0.4)");
      grad.addColorStop(0.88, "rgba(255,255,255,0.12)");
      grad.addColorStop(1, "rgba(255,255,255,0)");

      ctx.fillStyle = grad;
      ctx.fillRect(0, 0, width, height);

      if (maskLayerRef.current) {
        const dataUrl = canvas.toDataURL();
        maskLayerRef.current.style.webkitMaskImage = `url(${dataUrl})`;
        maskLayerRef.current.style.maskImage = `url(${dataUrl})`;
      }

      // subtle parallax on the grid layer, eased toward cursor offset
      if (gridRef.current) {
        const cx = width / 2, cy = height / 2;
        const ox = ((x - cx) / cx) * 16 || 0;
        const oy = ((y - cy) / cy) * 16 || 0;
        gridRef.current.style.transform = `translate(${ox * 0.06}px, ${oy * 0.06}px)`;
      }

      rafId.current = requestAnimationFrame(tick);
    };
    rafId.current = requestAnimationFrame(tick);

    return () => {
      window.removeEventListener("resize", resize);
      if (rafId.current) cancelAnimationFrame(rafId.current);
    };
  }, []);

  return (
    <section
      ref={sectionRef}
      onMouseMove={handlePointerMove}
      onMouseLeave={handlePointerLeave}
      className="cs-hero-section relative w-full overflow-hidden"
      style={{ background: "var(--bg, #080a0f)" }}
    >
      {/* Dynamic-viewport-height fix: h-screen/100vh breaks on iOS Safari once
          the address bar collapses. 100svh/100dvh are the correct units;
          the plain vh rule is the fallback for older browsers, and the
          @supports block below overrides it where dvh is available. */}
      <style>{`
        .cs-hero-section { height: 100vh; }
        @supports (height: 100svh) {
          .cs-hero-section { height: 100svh; }
        }
        @supports (height: 100dvh) {
          .cs-hero-section { height: 100dvh; }
        }
      `}</style>
      {/* Layer 0 — parallax blueprint grid */}
      <svg
        ref={gridRef}
        className="pointer-events-none absolute inset-0 h-full w-full transition-transform duration-100 ease-out"
        style={{ opacity: 0.1 }}
      >
        <defs>
          <pattern id="cs-hero-grid" width="48" height="48" patternUnits="userSpaceOnUse">
            <path d="M 48 0 L 0 0 0 48" fill="none" stroke="#64748b" strokeWidth="0.6" />
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#cs-hero-grid)" />
      </svg>

      {/* Layer 1 — ambient dark backdrop with brand-color glow (swap for a real product still when available) */}
      <div
        className="absolute inset-0"
        style={{
          background:
            "radial-gradient(ellipse 70% 55% at 50% 62%, rgba(79,127,255,0.16) 0%, transparent 70%), " +
            "radial-gradient(ellipse 50% 40% at 82% 15%, rgba(123,94,167,0.10) 0%, transparent 70%), " +
            "var(--bg, #080a0f)",
        }}
      />

      {/* Layer 2 — hero word. Centered in the middle third of the viewport
          rather than pinned to the top, so it reads as composed instead of
          cramped on short laptop screens (e.g. a 1366×768 T450) and doesn't
          collide with the nav. Sizes are set per-breakpoint below instead of
          one aggressive vw-driven clamp, which was the cause of the text
          spanning edge-to-edge on laptop widths. */}
      <div className="cs-hero-word pointer-events-none absolute inset-x-0 top-1/2 z-20 flex -translate-y-1/2 flex-col items-center px-4 text-center">
        <span
          className="cs-hero-word-main font-black uppercase leading-[0.85] tracking-tight"
          style={{
            fontFamily: "var(--display, 'Barlow Condensed', sans-serif)",
            color: "var(--w, #e8eaf2)",
          }}
        >
          CAPSTORE
        </span>
        <span
          className="cs-hero-word-sub mt-1 uppercase"
          style={{
            fontFamily: "var(--display, 'Barlow Condensed', sans-serif)",
            fontWeight: 800,
            letterSpacing: "0.03em",
            color: "transparent",
            WebkitTextStroke: "1.5px var(--blue, #4f7fff)",
          }}
        >
          ELITE COLLECTIVE
        </span>
      </div>

      {/* Responsive type scale — explicit steps per breakpoint instead of a
          single vw clamp, so the words never crowd the viewport width on
          laptop screens and stay legible (not oversized) on phones. */}
      <style>{`
        /* Phones — iOS & Android, portrait, ~360–430px wide */
        .cs-hero-word-main { font-size: 3.1rem; }
        .cs-hero-word-sub  { font-size: 1.35rem; letter-spacing: 0.02em; }

        /* Larger phones / small tablets, portrait */
        @media (min-width: 431px) {
          .cs-hero-word-main { font-size: 3.8rem; }
          .cs-hero-word-sub  { font-size: 1.7rem; }
        }

        /* Tablets */
        @media (min-width: 640px) {
          .cs-hero-word-main { font-size: 5.5rem; }
          .cs-hero-word-sub  { font-size: 2.4rem; }
        }

        /* Small laptops — T450-class (1366×768) lands here */
        @media (min-width: 1024px) {
          .cs-hero-word-main { font-size: 7.5rem; }
          .cs-hero-word-sub  { font-size: 3.1rem; }
        }

        /* Standard laptop / desktop */
        @media (min-width: 1440px) {
          .cs-hero-word-main { font-size: 9.5rem; }
          .cs-hero-word-sub  { font-size: 3.8rem; }
        }

        /* Large desktop */
        @media (min-width: 1920px) {
          .cs-hero-word-main { font-size: 12rem; }
          .cs-hero-word-sub  { font-size: 4.6rem; }
        }

        /* Short-viewport safety net — laptops like the T450 have limited
           vertical space (768px), so on short screens cap the size further
           regardless of width, keeping the nav and eyebrow line clear. */
        @media (max-height: 800px) {
          .cs-hero-word-main { font-size: min(7rem, 9vw); }
          .cs-hero-word-sub  { font-size: min(2.8rem, 3.6vw); }
        }
      `}</style>

      {/* Layer 3 — spotlight-revealed video, clipped to bottom 60% */}
      <div
        ref={maskLayerRef}
        className="absolute inset-0 z-30"
        style={{
          WebkitMaskRepeat: "no-repeat",
          maskRepeat: "no-repeat",
          WebkitMaskSize: "100% 100%",
          maskSize: "100% 100%",
        }}
      >
        <video
          className="h-full w-full object-cover"
          style={{ clipPath: "inset(40% 0 0 0)" }}
          src={VIDEO_SRC}
          autoPlay
          loop
          muted
          playsInline
        />
        <div
          className="absolute inset-0"
          style={{ background: "linear-gradient(0deg, rgba(8,10,15,0.55) 0%, transparent 45%)" }}
        />
      </div>

      {/* hidden canvas driving the spotlight mask */}
      <canvas ref={canvasRef} className="hidden" />

      {/* Nav + content sit above everything */}
      <div className="relative z-50 flex h-full flex-col">
        <nav className="flex items-center justify-between px-5 py-5 sm:px-8 sm:py-6 lg:px-12">
          <div className="flex items-baseline gap-2 select-none">
            <span
              className="uppercase"
              style={{
                fontFamily: "var(--display, 'Barlow Condensed', sans-serif)",
                fontSize: "22px",
                fontWeight: 800,
                letterSpacing: "3px",
                color: "var(--w, #e8eaf2)",
              }}
            >
              CAPSTORE
              <span style={{ color: "var(--blue, #4f7fff)" }}>.</span>
              <span style={{ opacity: 0.5, fontWeight: 400, fontSize: "14px" }}>KE</span>
            </span>
          </div>

          <div className="hidden items-center gap-3 md:flex">
            <div
              className="flex items-center gap-1 rounded-full px-1.5 py-1.5"
              style={{
                background: "rgba(79,127,255,0.06)",
                border: "1px solid rgba(79,127,255,0.18)",
                backdropFilter: "blur(14px)",
                WebkitBackdropFilter: "blur(14px)",
              }}
            >
              {NAV_LINKS.map(({ label, chevron }) => (
                <a
                  key={label}
                  href="#"
                  className="flex items-center gap-1 rounded-full px-4 py-1.5 text-sm font-medium transition-colors"
                  style={{ color: "rgba(232,234,242,0.75)" }}
                  onMouseEnter={(e) => (e.currentTarget.style.color = "#fff")}
                  onMouseLeave={(e) => (e.currentTarget.style.color = "rgba(232,234,242,0.75)")}
                >
                  {label}
                  {chevron && <ChevronDown className="h-3.5 w-3.5" />}
                </a>
              ))}
            </div>
            <button
              onClick={onShopNow}
              className="self-stretch rounded-full px-5 text-sm font-semibold uppercase tracking-wider text-black transition-opacity hover:opacity-90"
              style={{ background: "var(--blue, #4f7fff)", fontFamily: "var(--display, 'Barlow Condensed', sans-serif)" }}
            >
              Shop Now
            </button>
          </div>

          <button
            className="relative z-50 flex h-10 w-10 items-center justify-center rounded-full md:hidden"
            style={{ background: "rgba(79,127,255,0.08)", border: "1px solid rgba(79,127,255,0.18)" }}
            onClick={() => setMenuOpen((v) => !v)}
            aria-label="Toggle menu"
          >
            <Menu
              className={`absolute h-5 w-5 text-white transition-all duration-300 ${
                menuOpen ? "rotate-90 scale-0 opacity-0" : "rotate-0 scale-100 opacity-100"
              }`}
            />
            <X
              className={`absolute h-5 w-5 text-white transition-all duration-300 ${
                menuOpen ? "rotate-0 scale-100 opacity-100" : "-rotate-90 scale-0 opacity-0"
              }`}
            />
          </button>
        </nav>

        {/* mobile menu */}
        <div
          className={`fixed inset-0 z-40 bg-black/80 backdrop-blur-md transition-opacity duration-300 md:hidden ${
            menuOpen ? "opacity-100" : "pointer-events-none opacity-0"
          }`}
          onClick={() => setMenuOpen(false)}
        />
        <div
          className={`fixed right-0 top-0 z-40 flex h-full w-72 flex-col md:hidden transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] ${
            menuOpen ? "translate-x-0" : "translate-x-full"
          }`}
          style={{ background: "rgba(8,10,15,0.94)", backdropFilter: "blur(20px)" }}
        >
          <div className="flex flex-col gap-2 px-6 pt-24">
            {NAV_LINKS.map(({ label, chevron }, i) => (
              <a
                key={label}
                href="#"
                className="flex items-center justify-between rounded-xl px-4 py-3.5 text-base font-medium text-white/80 transition-colors hover:bg-white/10 hover:text-white"
                style={{
                  transitionProperty: "opacity, transform",
                  transitionDuration: "300ms",
                  transitionDelay: menuOpen ? `${(i + 1) * 60}ms` : "0ms",
                  opacity: menuOpen ? 1 : 0,
                  transform: menuOpen ? "translateX(0)" : "translateX(24px)",
                }}
              >
                {label}
                {chevron && <ChevronDown className="h-4 w-4" />}
              </a>
            ))}
          </div>
          <div
            className="mt-auto px-6 pb-10"
            style={{
              transitionProperty: "opacity, transform",
              transitionDuration: "400ms",
              transitionDelay: menuOpen ? "300ms" : "0ms",
              opacity: menuOpen ? 1 : 0,
              transform: menuOpen ? "translateY(0)" : "translateY(16px)",
            }}
          >
            <button
              onClick={onShopNow}
              className="w-full rounded-full px-6 py-3 text-sm font-semibold uppercase tracking-wider text-black"
              style={{ background: "var(--blue, #4f7fff)", fontFamily: "var(--display, 'Barlow Condensed', sans-serif)" }}
            >
              Shop Now
            </button>
          </div>
        </div>

        {/* eyebrow / helper line, bottom-anchored like the rest of the site's hero */}
        <div
          className="mt-auto px-5 pb-10 text-center sm:px-8 sm:pb-14"
          style={{
            fontFamily: "var(--mono, 'Share Tech Mono', monospace)",
            fontSize: "10px",
            letterSpacing: "4px",
            textTransform: "uppercase",
            color: "rgba(232,234,242,0.4)",
          }}
        >
          Move your cursor to reveal the drop
        </div>
      </div>
    </section>
  );
}